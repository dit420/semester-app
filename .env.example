# Copy to .env.local and fill in from your Supabase project settings -> API.
# The anon key is safe in the client: row level security is what protects data,
# not key secrecy. Never put the service_role key in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
